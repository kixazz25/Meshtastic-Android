package com.geeksville.mesh.convoy

import android.content.Intent
import android.net.Uri
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.OutlinedTextField
import androidx.compose.material3.OutlinedTextFieldDefaults
import androidx.compose.material3.Text
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

// ============================================================
// ConvoyRideDetailScreen.kt
// V3.0 Phase B — Ride Detail
// Entry: SHOW RIDE DETAILS from any dashboard panel (S1-S4)
// Phase C: replace seeder data with GET /rides/{id} +
//          GET /rides/{id}/enrollments API calls
// ============================================================

@Composable
fun ConvoyRideDetailScreen(
    rideId: String = "",
    onNavigateToSendInvite: () -> Unit = {},
    onNavigateToBroadcast: () -> Unit = {},
    onNavigateToCreateRide: () -> Unit = {},
    onNavigateToFieldRadio: () -> Unit = {},
    onBack: () -> Unit = {}
) {
    val context      = LocalContext.current
    val scrollState  = rememberScrollState()
    val currentUserId = remember { ConvoySessionManager.getUserId(context) ?: "" }

    // ── Seeder data — Phase C: replace with API ───────────────────────────────
    val rideName     = "Sunday Desert Run — Gooseberry Mesa"
    val visibility   = "PRIVATE"
    var rideStatus   by remember { mutableStateOf("open") }
    val city         = "Springdale, UT"
    val trailhead    = "Gooseberry Trailhead"
    var rideDate     by remember { mutableStateOf("April 13, 2026") }
    var arriveTime   by remember { mutableStateOf("7:30 AM") }
    var rolloutTime  by remember { mutableStateOf("8:00 AM") }
    var description  by remember { mutableStateOf("Moderate terrain, UTV recommended. Bring water and snacks. Meet at staging area.") }
    val orgName      = "Fred Dev"
    val orgEmail     = "fred@grouptrack.org"
    val orgId        = "dev-user-001"
    val isOrganizer  = orgId == currentUserId
    val canMaintain  = isOrganizer && rideStatus.lowercase() != "completed"
    val canRespond   = !isOrganizer && rideStatus.lowercase() == "open"

    // My enrollment status — Phase C: from API
    var myStatus by remember { mutableStateOf("accepted") }

    // UI state
    var showChangeForm by remember { mutableStateOf(false) }
    var showMap        by remember { mutableStateOf(false) }
    var accExpanded    by remember { mutableStateOf(false) }
    var maybeExpanded  by remember { mutableStateOf(false) }
    var declExpanded   by remember { mutableStateOf(false) }
    var invExpanded    by remember { mutableStateOf(false) }

    // Edit fields
    var editDate    by remember { mutableStateOf(rideDate) }
    var editArrive  by remember { mutableStateOf(arriveTime) }
    var editRollout by remember { mutableStateOf(rolloutTime) }
    var editDesc    by remember { mutableStateOf(description) }

    // Follow state
    var isFollowing by remember {
        mutableStateOf(
            (context.getSharedPreferences("grouptrack_follows", android.content.Context.MODE_PRIVATE)
                .getStringSet("followed_ids", emptySet()) ?: emptySet()).contains(orgId)
        )
    }

    fun launchEmail(address: String) {
        val intent = Intent(Intent.ACTION_SENDTO, Uri.parse("mailto:$address"))
        context.startActivity(Intent.createChooser(intent, "Send email"))
    }

    fun toggleFollow() {
        if (orgId.isEmpty() || orgId == currentUserId) return
        val prefs = context.getSharedPreferences("grouptrack_follows", android.content.Context.MODE_PRIVATE)
        val current = (prefs.getStringSet("followed_ids", emptySet()) ?: emptySet()).toMutableSet()
        isFollowing = if (isFollowing) {
            ConvoyEnrollmentQueue.unfollowOrganizer(context, orgId, orgName)
            current.remove(orgId); false
        } else {
            ConvoyEnrollmentQueue.followOrganizer(context, orgId, orgName)
            current.add(orgId); true
        }
        prefs.edit().putStringSet("followed_ids", current).apply()
    }

    // Seeded enrollment data — Phase C: from GET /rides/{id}/enrollments
    data class EnrolleeRow(val name: String, val email: String, val date: String)
    val accepted = listOf(
        EnrolleeRow("Dave Hatch",   "dave@grouptrack.org",   "Apr 10, 2026"),
        EnrolleeRow("Sarah Munoz",  "sarah@grouptrack.org",  "Apr 11, 2026"),
        EnrolleeRow("Tom Ridley",   "tom@grouptrack.org",    "Apr 11, 2026"),
        EnrolleeRow("Lisa Morris",  "lisa@grouptrack.org",   "Apr 12, 2026"),
        EnrolleeRow("Mike Torres",  "mike@grouptrack.org",   "Apr 12, 2026"),
    )
    val maybe = listOf(
        EnrolleeRow("Chris Webb",   "chris@grouptrack.org",  "Apr 9, 2026"),
        EnrolleeRow("Ann Walsh",    "ann@grouptrack.org",    "Apr 10, 2026"),
    )
    val declined = listOf(
        EnrolleeRow("Ray Olsen",    "ray@grouptrack.org",    "Apr 8, 2026"),
    )
    val invited = listOf(
        EnrolleeRow("Amy Ford",     "amy@grouptrack.org",    "Apr 7, 2026"),
        EnrolleeRow("Dan Nguyen",   "dan@grouptrack.org",    "Apr 9, 2026"),
        EnrolleeRow("Jen Park",     "jen@grouptrack.org",    "Apr 10, 2026"),
    )

    Column(modifier = Modifier.fillMaxSize().background(GroupTrackColors.Navy)) {

        // ── Top bar ───────────────────────────────────────────────────────────
        Row(
            modifier = Modifier.fillMaxWidth().background(Color(0xFF0A1628))
                .padding(horizontal = 14.dp, vertical = 10.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(10.dp)
        ) {
            Box(
                modifier = Modifier.clip(RoundedCornerShape(4.dp))
                    .background(Color(0xFF1A3050))
                    .clickable { onBack() }
                    .padding(horizontal = 10.dp, vertical = 5.dp)
            ) {
                Text("\u2190 BACK", color = Color(0xFF4AB8E8), fontSize = 10.sp,
                    fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace)
            }
            Text("RIDE DETAIL", color = Color.White, fontSize = 12.sp,
                fontWeight = FontWeight.Bold, letterSpacing = 2.sp,
                modifier = Modifier.weight(1f))
        }
        androidx.compose.material3.HorizontalDivider(thickness = 2.dp, color = Color(0xFF4AB8E8))

        Column(
            modifier = Modifier.fillMaxWidth().weight(1f)
                .verticalScroll(scrollState).padding(12.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {

            // ── HEADER PANEL ──────────────────────────────────────────────────
            Column(
                modifier = Modifier.fillMaxWidth().clip(RoundedCornerShape(8.dp))
                    .background(Color(0xFF0F2035)).padding(12.dp),
                verticalArrangement = Arrangement.spacedBy(5.dp)
            ) {
                // Line 1: Name + badges + CHANGE
                Row(modifier = Modifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(5.dp)) {
                    Text(text = rideName, color = Color.White, fontSize = 13.sp,
                        fontWeight = FontWeight.Bold, modifier = Modifier.weight(1f))
                    DetailVisibilityBadge(visibility)
                    DetailRideStatusBadge(rideStatus)
                    if (canMaintain) {
                        Box(
                            modifier = Modifier.clip(RoundedCornerShape(3.dp))
                                .background(Color.Transparent)
                                .clickable { showChangeForm = !showChangeForm }
                                .padding(horizontal = 8.dp, vertical = 3.dp)
                                .then(Modifier.clip(RoundedCornerShape(3.dp)))
                        ) {
                            Text("CHANGE", color = Color(0xFFF59E0B), fontSize = 9.sp,
                                fontWeight = FontWeight.Bold,
                                modifier = Modifier.clip(RoundedCornerShape(3.dp))
                                    .background(Color(0xFF1A3050))
                                    .padding(horizontal = 8.dp, vertical = 3.dp))
                        }
                    }
                }
                // Line 2: Location
                Text(text = "$city \u2014 $trailhead",
                    color = Color(0xFFAABBCC), fontSize = 11.sp)
                // Line 3: Date/time
                Text(text = "$rideDate \u00b7 Arrive $arriveTime \u00b7 Rollout $rolloutTime",
                    color = Color(0xFF4AB8E8), fontSize = 10.sp, fontFamily = FontFamily.Monospace)
                // Line 4: Organizer + email
                Row(verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(5.dp)) {
                    Text(text = orgName, color = Color.White, fontSize = 11.sp, fontWeight = FontWeight.Bold)
                    Text("\u00b7", color = Color(0xFF445566), fontSize = 9.sp)
                    Text(
                        text = orgEmail, color = Color(0xFF4AB8E8), fontSize = 10.sp,
                        fontFamily = FontFamily.Monospace,
                        modifier = Modifier.clickable { launchEmail(orgEmail) }
                    )
                }
                // Line 5: Description
                if (description.isNotEmpty()) {
                    Text(text = description, color = Color(0xFFAABBCC), fontSize = 10.sp,
                        lineHeight = 15.sp)
                }
                // Line 6: Follow
                if (!isOrganizer) {
                    Row(verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(5.dp),
                        modifier = Modifier.padding(top = 2.dp)) {
                        Text("FOLLOW", color = Color(0xFF4AB8E8), fontSize = 9.sp,
                            fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace,
                            letterSpacing = 1.sp)
                        Box(
                            modifier = Modifier.size(14.dp).clip(RoundedCornerShape(3.dp))
                                .background(if (isFollowing) Color(0xFF4AB8E8) else Color(0xFF1A3050))
                                .clickable { toggleFollow() },
                            contentAlignment = Alignment.Center
                        ) {
                            if (isFollowing) Text("\u2713", color = Color(0xFF0A1628),
                                fontSize = 9.sp, fontWeight = FontWeight.Bold)
                        }
                        Text(text = orgName, color = Color.White, fontSize = 11.sp,
                            fontWeight = FontWeight.Bold)
                    }
                }

                // ── CHANGE FORM (organizer only, inline) ──────────────────────
                if (showChangeForm) {
                    Spacer(Modifier.height(4.dp))
                    androidx.compose.material3.HorizontalDivider(
                        thickness = 1.dp, color = Color(0xFF1A2840))
                    Spacer(Modifier.height(6.dp))

                    listOf(
                        Triple("DATE",        editDate,    { v: String -> editDate = v }),
                        Triple("ARRIVE",      editArrive,  { v: String -> editArrive = v }),
                        Triple("ROLLOUT",     editRollout, { v: String -> editRollout = v }),
                        Triple("DESCRIPTION", editDesc,    { v: String -> editDesc = v }),
                    ).forEach { (label, value, onValue) ->
                        Row(verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.spacedBy(8.dp),
                            modifier = Modifier.fillMaxWidth()) {
                            Text(label, color = Color(0xFF445566), fontSize = 9.sp,
                                fontFamily = FontFamily.Monospace,
                                modifier = Modifier.width(76.dp))
                            OutlinedTextField(
                                value = value,
                                onValueChange = onValue,
                                modifier = Modifier.fillMaxWidth().height(44.dp),
                                singleLine = true,
                                textStyle = androidx.compose.ui.text.TextStyle(
                                    color = Color.White, fontSize = 10.sp,
                                    fontFamily = FontFamily.Monospace),
                                colors = OutlinedTextFieldDefaults.colors(
                                    focusedBorderColor = Color(0xFF4AB8E8),
                                    unfocusedBorderColor = Color(0xFF2A4060),
                                    focusedTextColor = Color.White,
                                    unfocusedTextColor = Color.White,
                                    cursorColor = Color(0xFF4AB8E8)
                                )
                            )
                        }
                    }
                    Spacer(Modifier.height(6.dp))
                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                        // SAVE
                        Box(modifier = Modifier.clip(RoundedCornerShape(4.dp))
                            .background(Color(0xFF22C55E).copy(alpha = 0.2f))
                            .clickable {
                                rideDate    = editDate
                                arriveTime  = editArrive
                                rolloutTime = editRollout
                                description = editDesc
                                showChangeForm = false
                            }
                            .padding(horizontal = 10.dp, vertical = 6.dp)) {
                            Text("SAVE — NOTIFY ALL RIDERS", color = Color(0xFF22C55E),
                                fontSize = 9.sp, fontWeight = FontWeight.Bold)
                        }
                        // CLOSE RIDE
                        Box(modifier = Modifier.clip(RoundedCornerShape(4.dp))
                            .background(Color(0xFF445566).copy(alpha = 0.2f))
                            .clickable { rideStatus = "closed"; showChangeForm = false }
                            .padding(horizontal = 10.dp, vertical = 6.dp)) {
                            Text("CLOSE RIDE", color = Color(0xFF8899AA),
                                fontSize = 9.sp, fontWeight = FontWeight.Bold)
                        }
                        // CANCEL RIDE
                        Box(modifier = Modifier.clip(RoundedCornerShape(4.dp))
                            .background(Color(0xFFEF4444).copy(alpha = 0.15f))
                            .clickable { rideStatus = "cancelled"; showChangeForm = false }
                            .padding(horizontal = 10.dp, vertical = 6.dp)) {
                            Text("CANCEL RIDE", color = Color(0xFFEF4444),
                                fontSize = 9.sp, fontWeight = FontWeight.Bold)
                        }
                    }
                }
            }

            // ── RIDE AREA MAP — twistie, collapsed by default ─────────────────
            Column(modifier = Modifier.fillMaxWidth().clip(RoundedCornerShape(8.dp))
                .background(Color(0xFF0F2035))) {
                Row(
                    modifier = Modifier.fillMaxWidth()
                        .clickable { showMap = !showMap }
                        .padding(horizontal = 12.dp, vertical = 10.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                        Text(if (showMap) "\u25bc" else "\u25b6",
                            color = Color(0xFF4AB8E8), fontSize = 10.sp)
                        Text("RIDE AREA MAP", color = Color.White, fontSize = 11.sp,
                            fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
                    }
                    Text("PHASE C", color = Color(0xFF2A4060), fontSize = 8.sp,
                        fontFamily = FontFamily.Monospace)
                }
                if (showMap) {
                    Box(
                        modifier = Modifier.fillMaxWidth().height(180.dp)
                            .background(Color(0xFF060E1A)),
                        contentAlignment = Alignment.Center
                    ) {
                        Column(horizontalAlignment = Alignment.CenterHorizontally,
                            verticalArrangement = Arrangement.spacedBy(6.dp)) {
                            Box(modifier = Modifier.size(36.dp).clip(RoundedCornerShape(18.dp))
                                .background(Color.Transparent)
                                .then(Modifier.clip(RoundedCornerShape(18.dp))),
                                contentAlignment = Alignment.Center) {
                                Box(modifier = Modifier.size(36.dp).clip(RoundedCornerShape(18.dp))
                                    .background(Color(0xFF4AB8E8).copy(alpha = 0.1f)))
                                Box(modifier = Modifier.size(12.dp).clip(RoundedCornerShape(6.dp))
                                    .background(Color(0xFF4AB8E8)))
                            }
                            Text("COMING SOON", color = Color(0xFF4AB8E8), fontSize = 13.sp,
                                fontWeight = FontWeight.Bold, fontFamily = FontFamily.Monospace,
                                letterSpacing = 3.sp)
                            Text("PHASE C — MAP INTEGRATION", color = Color(0xFF445566),
                                fontSize = 8.sp, fontFamily = FontFamily.Monospace, letterSpacing = 1.sp)
                        }
                    }
                }
            }

            // ── YOUR RESPONSE — rider only ────────────────────────────────────
            if (!isOrganizer) {
                Column(modifier = Modifier.fillMaxWidth().clip(RoundedCornerShape(8.dp))
                    .background(Color(0xFF0F2035)).padding(12.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)) {
                    Text("YOUR RESPONSE", color = Color(0xFF4AB8E8), fontSize = 9.sp,
                        fontWeight = FontWeight.Bold, letterSpacing = 2.sp,
                        fontFamily = FontFamily.Monospace)
                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                        DetailActionButton("ACCEPT",  myStatus == "accepted", canRespond, Color(0xFF22C55E)) { myStatus = "accepted" }
                        DetailActionButton("MAYBE",   myStatus == "maybe",    canRespond, Color(0xFFF59E0B)) { myStatus = "maybe" }
                        DetailActionButton("DECLINE", myStatus == "declined", canRespond, Color(0xFFEF4444)) { myStatus = "declined" }
                    }
                }
            }

            // ── ENROLLMENT TWISTIES ───────────────────────────────────────────
            Column(modifier = Modifier.fillMaxWidth().clip(RoundedCornerShape(8.dp))
                .background(Color(0xFF0F2035)).padding(10.dp),
                verticalArrangement = Arrangement.spacedBy(4.dp)) {
                Text("ENROLLMENT", color = Color(0xFF4AB8E8), fontSize = 9.sp,
                    fontWeight = FontWeight.Bold, letterSpacing = 2.sp,
                    fontFamily = FontFamily.Monospace,
                    modifier = Modifier.padding(bottom = 2.dp))

                EnrollmentTwistie("ACCEPTED", accepted.size, Color(0xFF22C55E), accExpanded,
                    { accExpanded = !accExpanded }) {
                    accepted.forEach { EnrolleeRow(it) { launchEmail(it.email) } }
                }
                EnrollmentTwistie("MAYBE", maybe.size, Color(0xFFF59E0B), maybeExpanded,
                    { maybeExpanded = !maybeExpanded }) {
                    maybe.forEach { EnrolleeRow(it) { launchEmail(it.email) } }
                }
                EnrollmentTwistie("DECLINED", declined.size, Color(0xFFEF4444), declExpanded,
                    { declExpanded = !declExpanded }) {
                    declined.forEach { EnrolleeRow(it) { launchEmail(it.email) } }
                }
                EnrollmentTwistie("INVITED — PENDING", invited.size, Color(0xFF445566), invExpanded,
                    { invExpanded = !invExpanded }) {
                    invited.forEach { EnrolleeRow(it) { launchEmail(it.email) } }
                }
            }

            Spacer(Modifier.height(8.dp))
        }

        // ── Bottom nav ────────────────────────────────────────────────────────
        GroupTrackBottomNav(
            activeTab = GroupTrackTab.RIDES,
            onHome    = { onBack() },
            onRides   = {},
            onMap     = { onBack() },
            onProfile = {},
            onRadio   = onNavigateToFieldRadio
        )
    }
}

// ── Enrollment Twistie ────────────────────────────────────────────────────────
@Composable
private fun EnrollmentTwistie(
    label: String, count: Int, color: Color,
    expanded: Boolean, onToggle: () -> Unit,
    content: @Composable () -> Unit
) {
    Column(modifier = Modifier.fillMaxWidth()) {
        Row(
            modifier = Modifier.fillMaxWidth()
                .clip(RoundedCornerShape(4.dp))
                .background(color.copy(alpha = 0.08f))
                .clickable { onToggle() }
                .padding(horizontal = 10.dp, vertical = 7.dp),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Row(verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                Text(if (expanded) "\u25bc" else "\u25b6",
                    color = color, fontSize = 9.sp)
                Text(label, color = color, fontSize = 10.sp,
                    fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
            }
            Box(modifier = Modifier.clip(RoundedCornerShape(10.dp))
                .background(color.copy(alpha = 0.2f))
                .padding(horizontal = 7.dp, vertical = 2.dp)) {
                Text(count.toString(), color = color, fontSize = 9.sp,
                    fontWeight = FontWeight.Bold)
            }
        }
        if (expanded) {
            Column(
                modifier = Modifier.fillMaxWidth().padding(
                    start = 10.dp, end = 10.dp, top = 4.dp, bottom = 2.dp),
                verticalArrangement = Arrangement.spacedBy(6.dp)
            ) { content() }
        }
    }
}

// ── Enrollee row ──────────────────────────────────────────────────────────────
@Composable
private fun EnrolleeRow(
    row: Any,
    onEmailTap: () -> Unit
) {
    // row is a data class with name, email, date — cast via reflection-free approach
    val (name, email, date) = when (row) {
        is Triple<*, *, *> -> Triple(row.first.toString(), row.second.toString(), row.third.toString())
        else -> return
    }
    Row(
        modifier = Modifier.fillMaxWidth(),
        horizontalArrangement = Arrangement.SpaceBetween,
        verticalAlignment = Alignment.Top
    ) {
        Column(verticalArrangement = Arrangement.spacedBy(1.dp)) {
            Text(name, color = Color.White, fontSize = 10.sp, fontWeight = FontWeight.Bold)
            Text(email, color = Color(0xFF4AB8E8), fontSize = 9.sp,
                fontFamily = FontFamily.Monospace,
                modifier = Modifier.clickable { onEmailTap() })
        }
        Text(date, color = Color(0xFF445566), fontSize = 8.sp,
            fontFamily = FontFamily.Monospace)
    }
}

// ── Action button ─────────────────────────────────────────────────────────────
@Composable
private fun DetailActionButton(
    label: String, active: Boolean, enabled: Boolean,
    activeColor: Color, onClick: () -> Unit
) {
    val textColor = when {
        !enabled -> Color(0xFF445566)
        active   -> activeColor
        else     -> activeColor.copy(alpha = 0.6f)
    }
    val bgColor = when {
        !enabled -> Color(0xFF1A3050).copy(alpha = 0.3f)
        active   -> activeColor.copy(alpha = 0.2f)
        else     -> Color(0xFF1A3050)
    }
    Box(
        modifier = Modifier.clip(RoundedCornerShape(4.dp)).background(bgColor)
            .then(if (enabled) Modifier.clickable { onClick() } else Modifier)
            .padding(horizontal = 10.dp, vertical = 6.dp)
    ) {
        Text(label, color = textColor, fontSize = 10.sp,
            fontWeight = if (active) FontWeight.ExtraBold else FontWeight.Bold,
            letterSpacing = 1.sp)
    }
}

// ── Badge composables ─────────────────────────────────────────────────────────
@Composable
private fun DetailVisibilityBadge(visibility: String) {
    val color = if (visibility.uppercase() == "PUBLIC") Color(0xFF4AB8E8) else Color(0xFFF59E0B)
    Box(modifier = Modifier.clip(RoundedCornerShape(4.dp))
        .background(color.copy(alpha = 0.15f))
        .padding(horizontal = 6.dp, vertical = 2.dp)) {
        Text(visibility.uppercase(), color = color, fontSize = 9.sp,
            fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
    }
}

@Composable
private fun DetailRideStatusBadge(status: String) {
    val (color, label) = when (status.lowercase()) {
        "open"      -> Color(0xFF22C55E) to "OPEN"
        "closed"    -> Color(0xFF445566) to "CLOSED"
        "cancelled" -> Color(0xFFEF4444) to "CANCELLED"
        "pending"   -> Color(0xFF445566) to "PENDING"
        "completed" -> Color(0xFF445566) to "COMPLETED"
        else        -> Color(0xFF22C55E) to "OPEN"
    }
    Box(modifier = Modifier.clip(RoundedCornerShape(4.dp))
        .background(color.copy(alpha = 0.15f))
        .padding(horizontal = 6.dp, vertical = 2.dp)) {
        Text(label, color = color, fontSize = 9.sp,
            fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
    }
}
